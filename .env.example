# Classifier server only. Copy to .env.local when using its OpenAI fallback.
OPENAI_API_KEY=
EXERCISE_OPENAI_FALLBACK_ENABLED=true
EXERCISE_OPENAI_MODEL=gpt-5.4-nano
EXERCISE_OPENAI_AFTER_SECONDS=8
# Hard request-count limit per server process (two checks per fallback session).
EXERCISE_OPENAI_MAX_CALLS=30
